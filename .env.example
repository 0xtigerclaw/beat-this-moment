PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
# Register an app at https://dev.twitch.tv/console/apps
# Set its OAuth redirect URL to http://localhost:3000/auth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Set this to your broadcaster Twitch login.
TWITCH_OWNER_CHANNEL=
# Required if you expose this server publicly. Choose a long random value.
HOST_KEY=
# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For, such as Caddy's default.
# It gives each player their own POST rate limit. Leave it off on a directly exposed server,
# where anyone could fake that header.
TRUST_PROXY=

# Optional persistent storage paths. Never place token files in public/.
# DATA_DIR=.data
# TWITCH_TOKEN_FILE=.data/twitch-session.json
